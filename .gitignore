# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated data and model artefacts are reproducible from the configs and
# seeds; they are not committed.
data/.medmnist_cache/**
data/raw/**
data/generated/**
data/references/**
models/checkpoints/**
models/metadata/**
# models/exported/ — small ONNX files are committed; nothing in there is large.
# Individual large files would be excluded here if they existed.
simulation/input/**
simulation/output/**
simulation/expected/**
results/classifier/**
!results/classifier/metrics.json
!results/classifier/confusion_matrix.png
!results/classifier/training_curves.png
results/denoising/**
results/rtl/**
!results/rtl/cosim_224x224.json
!results/rtl/synth_stats.json
!results/rtl/synth_ecp5.json
!results/rtl/pnr_ecp5.json
results/hardware/**
# Re-include directories so git can descend into them and find the keep-files
# below; without this, a nested .gitkeep stays invisible.
!**/
!**/.gitkeep

# RTL / EDA tool output
*.vvp
*.vcd
*.fst
obj_dir/
fpga/vivado/*
fpga/quartus/*
!fpga/vivado/.gitkeep
!fpga/quartus/.gitkeep
*.jou
*.log
!results/**/simulation_logs/*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code dev tooling — not needed in the deployed repo
.claude/

# ASIC flow outputs — generated by run_flow.sh, not committed
fpga/asic/results/*.v
fpga/asic/results/*.def
fpga/asic/results/*.odb
fpga/asic/results/*.gds
fpga/asic/results/*.guide
fpga/asic/results/*.txt
!fpga/asic/results/synth_stats.txt

# HLS generated files — compiled shared libraries are platform-specific.
# nnet_code_gen.h is 0.8 KB and IS committed (needed by CI g++ compile).
fpga/hls/**/*.so
fpga/hls/**/*.so.*

# Scratch / compiled artefacts at repo root
a.out
hello.sv
hello.vvp
